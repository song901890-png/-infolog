---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../consts';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 없거나 이동되었습니다." noindex>
  <div class="mx-auto max-w-content px-4 py-20 text-center">
    <p class="text-6xl font-extrabold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-extrabold text-white">페이지를 찾을 수 없습니다</h1>
    <p class="mt-3 text-muted">주소가 바뀌었거나 삭제된 글일 수 있습니다. 아래 카테고리에서 원하는 정보를 찾아보세요.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      {
        CATEGORIES.map((c) => (
          <li>
            <a href={`/category/${c.slug}/`} class="block rounded-full border border-line px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent">
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/" class="mt-8 inline-block rounded-xl bg-accent px-6 py-3 font-bold text-navy">홈으로 가기</a>
  </div>
</BaseLayout>
