---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="글 검색" description="인포로그의 모든 글을 제목·설명·태그로 검색하세요." noindex>
  <div class="mx-auto max-w-content px-4 pt-8">
    <h1 class="text-3xl font-extrabold text-white">글 검색</h1>
    <form id="search-form" role="search" class="mt-6" action="/search/" method="get">
      <label for="q" class="sr-only">검색어</label>
      <div class="flex gap-2">
        <input
          id="q"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="예: DNS, 웹툰, 중계"
          class="h-12 min-w-0 flex-1 rounded-xl border border-line bg-card px-4 text-base text-white placeholder:text-muted focus:border-accent focus:outline-none"
        />
        <button type="submit" class="h-12 shrink-0 rounded-xl bg-accent px-5 font-bold text-navy">검색</button>
      </div>
    </form>
    <p id="search-status" class="mt-4 text-sm text-muted" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 space-y-3"></ul>
  </div>
</BaseLayout>

<script>
  type Item = { t: string; d: string; c: string; g: string[]; u: string; p: string };

  const input = document.getElementById('q') as HTMLInputElement;
  const form = document.getElementById('search-form') as HTMLFormElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLParagraphElement;
  let index: Item[] | null = null;

  async function load() {
    if (!index) index = (await (await fetch('/search.json')).json()) as Item[];
    return index;
  }

  function render(items: Item[], q: string) {
    list.replaceChildren();
    if (!q) {
      status.textContent = '';
      return;
    }
    status.textContent = `"${q}" 검색 결과 ${items.length}건`;
    for (const it of items.slice(0, 30)) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = it.u;
      a.className = 'block rounded-xl border border-line/70 bg-card p-4 hover:border-accent/60';
      const meta = document.createElement('p');
      meta.className = 'text-xs font-bold text-accent';
      meta.textContent = `${it.c} · ${it.p}`;
      const title = document.createElement('p');
      title.className = 'mt-1 font-bold text-white';
      title.textContent = it.t;
      const desc = document.createElement('p');
      desc.className = 'mt-1 line-clamp-2 text-sm text-muted';
      desc.textContent = it.d;
      a.append(meta, title, desc);
      li.append(a);
      list.append(li);
    }
  }

  async function run(q: string) {
    const query = q.trim().toLowerCase();
    if (!query) return render([], '');
    const terms = query.split(/\s+/);
    const data = await load();
    const hits = data.filter((it) => {
      const hay = `${it.t} ${it.d} ${it.c} ${it.g.join(' ')}`.toLowerCase();
      return terms.every((term) => hay.includes(term));
    });
    render(hits, q.trim());
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => run(input.value), 150);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = new URL(location.href);
    url.searchParams.set('q', input.value.trim());
    history.replaceState(null, '', url);
    run(input.value);
  });

  const initial = new URLSearchParams(location.search).get('q') ?? '';
  if (initial) {
    input.value = initial;
    run(initial);
  } else {
    input.focus();
  }
</script>
