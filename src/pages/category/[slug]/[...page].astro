---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import SoftCTA from '../../../components/SoftCTA.astro';
import { CATEGORIES, SITE } from '../../../consts';
import { getPublishedPosts, type Post } from '../../../utils/posts';
import { WEBSITE_ID } from '../../../utils/schema';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return CATEGORIES.flatMap((category) =>
    paginate(
      posts.filter((p) => p.data.category === category.slug),
      { params: { slug: category.slug }, props: { category }, pageSize: SITE.postsPerPage },
    ),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  category: (typeof CATEGORIES)[number];
}

const { page, category } = Astro.props;
const suffix = page.currentPage > 1 ? ` (${page.currentPage}페이지)` : '';
const site = Astro.site ?? new URL(SITE.url);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.name,
    description: category.description,
    url: new URL(Astro.url.pathname, site).href,
    inLanguage: SITE.lang,
    isPartOf: { '@id': WEBSITE_ID },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: category.name, item: new URL(`/category/${category.slug}/`, site).href },
    ],
  },
];
---

<BaseLayout
  title={`${category.name}${suffix}`}
  description={`${category.description}${suffix}`}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
  jsonLd={jsonLd}
  noindex={page.total === 0}
>
  <div class="mx-auto max-w-6xl px-4 pt-8">
    <Breadcrumb items={[{ name: '홈', href: '/' }, { name: category.name }]} />
    <header class="mt-4 rounded-2xl border border-line/70 bg-card/60 p-6">
      <p class="text-sm font-bold text-accent">카테고리</p>
      <h1 class="mt-1 text-3xl font-extrabold text-white">{category.name}</h1>
      <p class="mt-2 text-muted">{category.description}</p>
      <p class="mt-3 text-sm text-muted">총 {page.total}개의 글</p>
    </header>

    {
      category.slug === 'guide' && page.currentPage === 1 && (
        <a
          href="/links/"
          class="group mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sky/40 bg-sky/10 p-5 transition-colors hover:border-sky"
        >
          <span>
            <span class="block text-lg font-extrabold text-white">웹툰·스포츠중계·OTT 공식 사이트 링크모음</span>
            <span class="mt-1 block text-sm text-muted">자주 찾는 공식 사이트 주소를 한 페이지에서 바로 확인하세요.</span>
          </span>
          <span class="shrink-0 rounded-xl bg-sky px-4 py-2 text-sm font-bold text-navy group-hover:brightness-110">링크모음 바로가기 →</span>
        </a>
      )
    }

    {
      page.data.length > 0 ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-10 rounded-xl border border-dashed border-line p-10 text-center text-muted">아직 발행된 글이 없습니다. 곧 새 글이 올라옵니다.</p>
      )
    }

    <Pagination page={page} baseUrl={`/category/${category.slug}/`} />

    <SoftCTA />
  </div>
</BaseLayout>
