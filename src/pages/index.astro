---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SoftCTA from '../components/SoftCTA.astro';
import { CATEGORIES, CTA, SITE } from '../consts';
import { organizationSchema, websiteSchema } from '../utils/schema';
import linksData from '../data/links.json';

const linkSections = linksData.sections;
import { formatDate, lastModified, postUrl, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const latest = rest.slice(0, 6);
const byCategory = CATEGORIES.map((c) => ({
  ...c,
  posts: posts.filter((p) => p.data.category === c.slug).slice(0, 3),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [websiteSchema(), organizationSchema(CTA.enabled ? [CTA.url] : [])],
};
---

<BaseLayout title={SITE.homeTitle} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4">
    <!-- Hero -->
    <section class="pb-8 pt-10 sm:pt-14">
      <p class="text-sm font-bold text-accent">매일 1편 · 정보 매거진</p>
      <h1 class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
        스포츠중계 접속오류·웹툰주소정보와 링크모음,<br /> <span class="text-sky">3분</span>이면 충분하게
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{SITE.description}</p>
    </section>

    {
      featured && (
        <section aria-labelledby="featured-title" class="mb-12">
          <article class="group relative overflow-hidden rounded-3xl border border-accent/30 bg-[radial-gradient(120%_140%_at_100%_0%,#0d3a3a_0%,#1e293b_50%,#141f33_100%)] p-6 sm:p-10">
            <span class="rounded-md bg-accent px-2 py-1 text-xs font-extrabold text-navy">오늘의 글</span>
            <h2 id="featured-title" class="mt-4 max-w-3xl text-2xl font-extrabold leading-snug text-white group-hover:text-accent sm:text-3xl">
              <a href={postUrl(featured)} class="after:absolute after:inset-0 after:content-['']">
                {featured.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted sm:text-base">{featured.data.description}</p>
            {featured.data.summary.length > 0 && (
              <ul class="mt-5 grid gap-2 text-sm text-ink sm:grid-cols-3">
                {featured.data.summary.slice(0, 3).map((s) => (
                  <li class="flex gap-2 rounded-xl bg-navy/50 p-3">
                    <span class="text-accent" aria-hidden="true">✓</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            )}
            <p class="mt-5 text-sm text-muted">
              <time datetime={lastModified(featured).toISOString()}>{formatDate(lastModified(featured))}</time> 업데이트
            </p>
          </article>
        </section>
      )
    }

    {
      latest.length > 0 && (
        <section aria-labelledby="latest-title" class="mb-12">
          <div class="mb-4 flex items-end justify-between">
            <h2 id="latest-title" class="text-xl font-extrabold text-white sm:text-2xl">
              최신 글
            </h2>
            <a href="/blog/" class="text-sm font-semibold text-sky hover:underline">
              전체 글 보기 →
            </a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {latest.map((post) => (
              <PostCard post={post} headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    }

    <SoftCTA />

    <section aria-labelledby="links-hub-title" class="mt-12 rounded-2xl border border-sky/40 bg-card/60 p-6 sm:p-8">
      <p class="text-sm font-bold text-sky">공식 링크 허브</p>
      <h2 id="links-hub-title" class="mt-1 text-xl font-extrabold text-white sm:text-2xl">웹툰·스포츠중계·OTT 공식 사이트 모음</h2>
      <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-muted">
        가짜 주소 걱정 없이, 운영사가 직접 운영하는 공식 사이트로 바로 접속하세요. 모든 링크는 정기적으로 접속 여부를 확인합니다.
      </p>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm">
        {linkSections.map((s) => (
          <li>
            <a href={`/links/#${s.id}`} class="block rounded-full border border-line px-3 py-1.5 text-ink hover:border-accent hover:text-accent">
              {s.title.replace(/ 모음$/, '')}
            </a>
          </li>
        ))}
      </ul>
      <a href="/links/" class="mt-5 inline-block rounded-xl bg-sky px-5 py-2.5 text-sm font-bold text-navy hover:brightness-110">
        공식 링크 모음 전체 보기 →
      </a>
    </section>

    <section aria-labelledby="categories-title" class="mt-12">
      <h2 id="categories-title" class="mb-4 text-xl font-extrabold text-white sm:text-2xl">카테고리별 정보</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          byCategory.map((c) => (
            <div class="rounded-2xl border border-line/70 bg-card/60 p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-bold text-white">
                    <a href={`/category/${c.slug}/`} class="hover:text-accent">
                      {c.name}
                    </a>
                  </h3>
                  <p class="mt-1 text-sm text-muted">{c.description}</p>
                </div>
                <a href={`/category/${c.slug}/`} class="shrink-0 text-sm font-semibold text-sky hover:underline">
                  {c.short} 글 전체
                </a>
              </div>
              {c.posts.length > 0 ? (
                <ul class="mt-4 divide-y divide-line/60">
                  {c.posts.map((p) => (
                    <li>
                      <a href={postUrl(p)} class="flex items-center justify-between gap-3 py-2.5 text-[15px] text-ink hover:text-accent">
                        <span class="line-clamp-1">{p.data.title}</span>
                        <time datetime={p.data.pubDate.toISOString()} class="shrink-0 text-xs text-muted">
                          {formatDate(p.data.pubDate).replace(/^\d{4}년 /, '')}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-4 text-sm text-muted">곧 새 글이 발행됩니다.</p>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
