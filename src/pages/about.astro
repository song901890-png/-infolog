---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CATEGORIES, CTA, SITE } from '../consts';
import { organizationSchema } from '../utils/schema';

const site = Astro.site ?? new URL(SITE.url);
const url = new URL('/about/', site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${url}#webpage`,
    url,
    name: `${SITE.name} 소개`,
    inLanguage: SITE.lang,
    about: organizationSchema(CTA.enabled ? [CTA.url] : []),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: '소개', item: url },
    ],
  },
];
---

<BaseLayout
  title="인포로그 소개 · 편집 원칙"
  description={`${SITE.name}은 스포츠 중계, 링크모음, 웹툰·OTT·애니 플랫폼, 피싱·보안, 주간 이슈를 매일 한 편씩 정리하는 정보 블로그입니다. 운영 목적과 편집·검증 원칙, 문의 방법을 안내합니다.`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-content px-4 pt-8">
    <Breadcrumb items={[{ name: '홈', href: '/' }, { name: '소개' }]} />
    <h1 class="mt-4 text-3xl font-extrabold text-white">인포로그 소개</h1>
    <div class="prose prose-lg mt-8 max-w-none max-sm:prose-base">
      <p>
        <strong>{SITE.name}({SITE.nameEn})</strong>은 일상에서 자주 찾게 되는 정보를 <strong>매일 한 편씩</strong>, 3분 안에 읽을 수
        있도록 정리하는 정보 블로그입니다. {SITE.since.replace('-', '년 ')}월부터 운영하고 있습니다.
      </p>

      <h2>다루는 주제</h2>
      <ul>
        {
          CATEGORIES.map((c) => (
            <li>
              <a href={`/category/${c.slug}/`}>{c.name}</a> — {c.description}
            </li>
          ))
        }
      </ul>

      <h2>편집 원칙</h2>
      <ol>
        <li><strong>1차 출처 우선:</strong> 리그·플랫폼·공공기관의 공식 발표와 공지를 기준으로 작성합니다.</li>
        <li><strong>합법 서비스만 안내:</strong> 저작권을 침해하는 불법 사이트나 그 주소는 소개하지 않습니다.</li>
        <li><strong>날짜 명시:</strong> 모든 글에 발행일과 최종 수정일을 표기하고, 정책이 바뀌면 내용을 갱신합니다.</li>
        <li><strong>핵심 먼저:</strong> 글 상단에 3줄 요약을 두어 바쁜 독자도 핵심을 바로 확인할 수 있게 합니다.</li>
        <li><strong>광고·협찬 구분:</strong> 대가를 받고 작성한 글이 있다면 본문 상단에 명확히 표시합니다.</li>
      </ol>

      <h2>정정 요청</h2>
      <p>
        글에서 잘못된 정보나 오래된 내용을 발견하시면 아래 연락처로 알려 주세요. 확인 후 빠르게 수정하고, 수정일을 글에 반영합니다.
      </p>

      <h2 id="contact">문의</h2>
      <ul>
        {SITE.contactEmail && (
          <li>
            이메일: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          </li>
        )}
        {CTA.enabled && (
          <li>
            공식 텔레그램: <a href={CTA.url} target="_blank" rel="noopener">{CTA.url.replace('https://', '')}</a>
          </li>
        )}
        {!SITE.contactEmail && !CTA.enabled && <li>문의 채널을 준비하고 있습니다.</li>}
      </ul>

      <h2>면책 고지</h2>
      <p>
        {SITE.name}의 콘텐츠는 일반적인 정보 제공을 목적으로 하며, 특정 서비스의 이용을 권유하거나 보증하지 않습니다. 서비스 정책·요금·일정은
        수시로 바뀔 수 있으므로 최종 결정 전 반드시 공식 채널에서 확인하시기 바랍니다. 개인정보 처리에 관한 내용은{' '}
        <a href="/privacy/">개인정보처리방침</a>에서 확인할 수 있습니다.
      </p>
    </div>
  </article>
</BaseLayout>
