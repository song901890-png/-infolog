---
/**
 * 공식 링크 허브 — /links/
 * 데이터: src/data/links.json  (주소 추가·수정 후 checked 날짜 갱신 → npm run links 로 접속 확인)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { SITE } from '../consts';
import { formatDate } from '../utils/posts';
import { WEBSITE_ID, organizationSchema } from '../utils/schema';
import data from '../data/links.json';

const site = Astro.site ?? new URL(SITE.url);
const url = new URL('/links/', site).href;
const checked = new Date(`${data.checked}T00:00:00+09:00`);
const domain = (u: string) => new URL(u).hostname.replace(/^www\./, '');
/** 여러 분류에 중복으로 실린 사이트(티빙·쿠팡플레이 등)는 한 번만 셈 */
const total = new Set(data.sections.flatMap((s) => s.links.map((l) => l.url))).size;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: '웹툰·스포츠중계·OTT 공식 사이트 링크 모음',
    description: `웹툰, 스포츠중계, OTT, 리그 공식 사이트 ${total}곳의 공식 주소를 한곳에 모았습니다.`,
    inLanguage: SITE.lang,
    dateModified: checked.toISOString(),
    isPartOf: { '@id': WEBSITE_ID },
    publisher: organizationSchema(),
    mainEntity: data.sections.map((s) => ({
      '@type': 'ItemList',
      name: s.title,
      numberOfItems: s.links.length,
      itemListElement: s.links.map((l, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: l.name,
        url: l.url,
      })),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: '링크모음', item: new URL('/category/guide/', site).href },
      { '@type': 'ListItem', position: 3, name: '공식 링크 모음', item: url },
    ],
  },
];
---

<BaseLayout
  title="웹툰·스포츠중계·OTT 공식 사이트 링크 모음"
  description={`웹툰 사이트, 스포츠중계 플랫폼, OTT, 리그 공식 사이트 ${total}곳의 공식 주소를 한곳에 모았습니다. 피싱·불법 사이트 걱정 없이 공식 링크로 바로 접속하세요.`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-content px-4 pt-8">
    <Breadcrumb items={[{ name: '홈', href: '/' }, { name: '링크모음', href: '/category/guide/' }, { name: '공식 링크 모음' }]} />

    <header class="mt-4">
      <p class="text-sm font-bold text-accent">공식 링크 허브</p>
      <h1 class="mt-1 text-3xl font-extrabold leading-tight text-white sm:text-4xl">웹툰·스포츠중계·OTT 공식 사이트 링크 모음</h1>
      <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">
        자주 찾는 웹툰 사이트와 스포츠중계 플랫폼, OTT, 리그 공식 사이트 주소를 한곳에 모았습니다. 운영사가 직접 운영하는{' '}
        <strong class="text-ink">공식 주소만</strong> 싣기 때문에 가짜·불법 사이트로 연결될 걱정이 없습니다.
      </p>
      <p class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-sky/40 bg-sky/10 px-3 py-1 text-xs font-semibold text-sky">
        공식 링크 {total}곳 · 마지막 확인 <time datetime={checked.toISOString()}>{formatDate(checked)}</time>
      </p>
    </header>

    <nav aria-label="링크 분류 바로가기" class="mt-8">
      <ul class="flex flex-wrap gap-2 text-sm">
        {
          data.sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="block rounded-full border border-line px-3 py-1.5 text-muted hover:border-accent hover:text-accent">
                {s.title.replace(/ 모음$/, '')}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      data.sections.map((s) => (
        <section id={s.id} class="mt-12 scroll-mt-28" aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`} class="text-2xl font-extrabold text-white">
            {s.title}
          </h2>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{s.description}</p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {s.links.map((l) => (
              <li>
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener"
                  class="group flex h-full items-start justify-between gap-3 rounded-xl border border-line/70 bg-card p-4 transition hover:border-accent/60"
                >
                  <span class="min-w-0">
                    <span class="block font-bold text-white group-hover:text-accent">{l.name}</span>
                    <span class="mt-1 block text-sm leading-relaxed text-muted">{l.note}</span>
                    <span class="mt-2 block truncate text-xs font-semibold text-sky">{domain(l.url)}</span>
                  </span>
                  <svg
                    class="mt-1 shrink-0 text-muted group-hover:text-accent"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                  <span class="sr-only">(새 창에서 열림)</span>
                </a>
              </li>
            ))}
          </ul>
          {s.related && (
            <p class="mt-4 text-sm text-muted">
              함께 읽기:{' '}
              <a href={s.related.href} class="font-semibold text-sky hover:underline">
                {s.related.label}
              </a>
            </p>
          )}
        </section>
      ))
    }

    <aside class="mt-12 rounded-xl border-l-4 border-sky bg-card/80 p-5 text-[15px] leading-relaxed text-ink" aria-label="이용 안내">
      <p class="font-bold text-white">이 페이지에 없는 '주소 모음'은 조심하세요</p>
      <p class="mt-2 text-muted">
        검색 결과나 메신저로 받은 '링크 모음', '주소 모음' 중에는 공식 사이트를 흉내 낸 피싱 사이트나 저작권을 침해하는 불법 사이트가
        섞여 있는 경우가 많습니다. 접속 전 주소창의 도메인이 위 공식 주소와 정확히 같은지 확인하세요. 잘못된 링크나 바뀐 주소를
        발견하면 <a href="/about/#contact" class="text-sky hover:underline">문의</a>로 알려 주세요.
      </p>
    </aside>

    <FaqAccordion items={data.faq} />
  </div>
</BaseLayout>
