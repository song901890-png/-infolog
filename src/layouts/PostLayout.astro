---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SummaryBox from '../components/SummaryBox.astro';
import MainBannerCTA from '../components/MainBannerCTA.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import { SITE, getCategory } from '../consts';
import { WEBSITE_ID, organizationSchema } from '../utils/schema';
import { formatDate, lastModified, postUrl, readingTime, wordCount, postOgImage, type Post } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, summary, faq, ogImage } = post.data;
const cat = getCategory(category);
const site = Astro.site ?? new URL(SITE.url);
const url = new URL(postUrl(post), site).href;
const categoryUrl = new URL(`/category/${cat.slug}/`, site).href;
const ogPath = ogImage ?? postOgImage(post);
const image = new URL(ogPath, site).href;
const modified = lastModified(post);
const minutes = readingTime(post.body);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: title,
  description,
  image: [image],
  datePublished: pubDate.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: SITE.lang,
  articleSection: cat.name,
  keywords: tags.join(', '),
  wordCount: wordCount(post.body),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@type': 'Organization', name: SITE.author, url: new URL('/about/', site).href },
  // 다른 페이지에 정의된 @id 는 검색엔진이 따라가지 않으므로 페이지마다 전체 엔티티를 포함
  publisher: organizationSchema(),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: cat.name, item: categoryUrl },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogPath}
  type="article"
  publishedTime={pubDate}
  modifiedTime={modified}
  tags={tags}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article class="mx-auto max-w-content px-4 pt-6 sm:pt-10">
    <Breadcrumb items={[{ name: '홈', href: '/' }, { name: cat.name, href: `/category/${cat.slug}/` }, { name: title }]} />

    <header class="mt-5">
      <a href={`/category/${cat.slug}/`} class="inline-block rounded-md bg-accent/10 px-2.5 py-1 text-xs font-bold text-accent hover:bg-accent/20">
        {cat.name}
      </a>
      <h1 class="mt-3 text-[1.7rem] font-extrabold leading-tight tracking-tight text-white sm:text-4xl">{title}</h1>
      <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <a href="/about/" rel="author" class="hover:text-accent">{SITE.author}</a>
        <span aria-hidden="true">·</span>
        <span>발행 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                수정 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{minutes}분 읽기</span>
      </div>
    </header>

    <div class="mt-6">
      <SummaryBox items={summary} updatedDate={modified} />
    </div>

    <div class="prose prose-lg mt-8 max-w-none prose-headings:font-extrabold prose-img:rounded-xl max-sm:prose-base">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2" aria-label="태그">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">#{tag}</li>
          ))}
        </ul>
      )
    }

    <MainBannerCTA />

    {faq && faq.length > 0 && <FaqAccordion items={faq} />}

    <RelatedPosts currentId={post.id} category={category} />
  </article>

  <StickyMobileBar slot="body-end" />
</BaseLayout>
