---
/**
 * <MainBannerCTA /> — 본문 하단 강조 배너 (글을 끝까지 읽은 유저용)
 * PostLayout 에서 본문 뒤에 자동 삽입되며, MDX 에서도 <MainBannerCTA /> 로 사용할 수 있습니다.
 */
import { CTA } from '../consts';

interface Props {
  title?: string;
  text?: string;
  buttonText?: string;
  href?: string;
}

const { title = CTA.bannerTitle, text = CTA.bannerText, buttonText = CTA.label, href = CTA.url } = Astro.props;
// CTA URL 이 미설정(placeholder)이면 렌더링하지 않음 — 깨진 외부 링크 방지
const show = href === CTA.url ? CTA.enabled : Boolean(href);
---

{show && (
<section
  class="not-prose relative my-10 overflow-hidden rounded-2xl border border-accent/40 bg-[radial-gradient(120%_120%_at_0%_0%,#123b2f_0%,#1e293b_45%,#0f172a_100%)] p-6 text-center shadow-xl shadow-black/30 sm:p-8"
  aria-labelledby="main-cta-title"
>
  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-accent/10 blur-2xl" aria-hidden="true"></div>
  <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent">
    <span class="relative flex h-2 w-2" aria-hidden="true">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:animate-none"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
    </span>
    실시간 공식 채널
  </span>
  <p id="main-cta-title" class="mt-4 text-xl font-extrabold leading-snug text-white sm:text-2xl">{title}</p>
  <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-muted">{text}</p>
  <a
    href={href}
    target="_blank"
    rel="noopener nofollow"
    class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-base font-extrabold text-navy shadow-lg shadow-accent/20 transition hover:brightness-110 sm:w-auto"
    data-cta="banner"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.2 13 1.3 11.5c-1-.3-1.1-1 .2-1.5L20.6 2.6c.9-.3 1.6.2 1.3 1.7z"></path>
    </svg>
    {buttonText}
  </a>
</section>
)}
