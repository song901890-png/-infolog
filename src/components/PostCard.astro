---
import { getCategory } from '../consts';
import { formatDate, lastModified, postUrl, type Post } from '../utils/posts';

interface Props {
  post: Post;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, compact = false, headingLevel = 'h2' } = Astro.props;
const { title, description, category } = post.data;
const cat = getCategory(category);
const date = lastModified(post);
const Heading = headingLevel;
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-line/70 bg-card p-5 transition hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-lg hover:shadow-black/30 motion-reduce:hover:translate-y-0"
>
  <div class="mb-3 flex items-center gap-2 text-xs">
    <a href={`/category/${cat.slug}/`} class="relative z-10 rounded-md bg-accent/10 px-2 py-1 font-bold text-accent hover:bg-accent/20">
      {cat.name}
    </a>
    <time datetime={date.toISOString()} class="text-muted">{formatDate(date)}</time>
  </div>
  <Heading class:list={['font-bold leading-snug text-white group-hover:text-accent', compact ? 'text-base' : 'text-lg']}>
    <a href={postUrl(post)} class="after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </Heading>
  {!compact && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>}
  <span class="mt-auto pt-4 text-sm font-semibold text-sky" aria-hidden="true">자세히 보기 →</span>
</article>
