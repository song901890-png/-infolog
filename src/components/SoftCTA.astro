---
/**
 * <SoftCTA /> — 본문 초반/중반용 텍스트형 전환 배너
 * MDX 본문에서 import 없이 바로 사용: <SoftCTA /> 또는 <SoftCTA text="..." buttonText="..." />
 */
import { CTA } from '../consts';

interface Props {
  text?: string;
  buttonText?: string;
  href?: string;
}

const { text = CTA.softText, buttonText = CTA.label, href = CTA.url } = Astro.props;
// CTA URL 이 미설정(placeholder)이면 렌더링하지 않음 — 깨진 외부 링크 방지
const show = href === CTA.url ? CTA.enabled : Boolean(href);
---

{show && (
<aside
  class="not-prose my-8 flex flex-col gap-3 rounded-xl border-l-4 border-sky bg-card/80 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5"
  aria-label="공식 채널 안내"
>
  <p class="flex items-start gap-2 text-[15px] leading-relaxed text-ink">
    <svg class="mt-1 shrink-0 text-sky" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path>
    </svg>
    <span>{text}</span>
  </p>
  <a
    href={href}
    target="_blank"
    rel="noopener nofollow"
    class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-sky px-4 py-2.5 text-sm font-bold text-navy transition hover:brightness-110"
    data-cta="soft"
  >
    {buttonText}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </a>
</aside>
)}
